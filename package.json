{
  "name": "@leverui/components",
  "version": "1.0.0-next.0",
  "description": "Accessible Solid 2 components with CSS-first theming and server rendering.",
  "keywords": [
    "solid",
    "solidjs",
    "solid-js",
    "components",
    "ui",
    "design-system",
    "accessibility",
    "ssr",
    "css"
  ],
  "homepage": "https://leverui.com",
  "bugs": {
    "url": "https://github.com/leverui/leverui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leverui/leverui.git"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "node": "./dist/server/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "typecheck": "node scripts/generate-public-entry.mjs --check && node scripts/build-declarations.mjs && node scripts/typecheck-project.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "pnpm build",
    "storybook": "pnpm build && storybook dev -p 6006 --host 127.0.0.1",
    "storybook:internal": "pnpm build && LEVERUI_STORYBOOK_INTERNAL=1 storybook dev -p 6008 --host 127.0.0.1",
    "build:storybook": "pnpm build && storybook build",
    "build:storybook:internal": "pnpm build && LEVERUI_STORYBOOK_INTERNAL=1 storybook build",
    "test:browser": "playwright test",
    "test:examples": "LEVERUI_STORYBOOK_EXAMPLES=1 playwright test",
    "test:server": "pnpm build && vitest run --config vite.server-test.config.ts",
    "test:packed-consumer": "pnpm build && node scripts/verify-packed-consumer.mjs",
    "test:release-bundles": "pnpm build && node --test tests/tooling/release-module-policy.test.mjs && node scripts/verify-release-bundles.mjs",
    "test:packed-combobox": "pnpm build && node scripts/verify-packed-combobox.mjs",
    "test:packed-date-input": "pnpm build && node scripts/verify-packed-date-input.mjs",
    "test:packed-date-picker": "pnpm build && node scripts/verify-packed-date-picker.mjs",
    "test:packed-download-trigger": "pnpm build && node scripts/verify-packed-download-trigger.mjs",
    "test:packed-scroll-area": "pnpm build && node scripts/verify-packed-scroll-area.mjs",
    "test:packed-listbox": "pnpm build && node scripts/verify-packed-listbox.mjs",
    "test:packed-radio-group": "pnpm build && node scripts/verify-packed-radio-group.mjs",
    "test:packed-rating-group": "pnpm build && node scripts/verify-packed-rating-group.mjs",
    "test:packed-segment-group": "pnpm build && node scripts/verify-packed-segment-group.mjs",
    "test:packed-select": "pnpm build && node scripts/verify-packed-select.mjs",
    "test:packed-slider": "pnpm build && node scripts/verify-packed-slider.mjs",
    "test:packed-tags-input": "pnpm build && node scripts/verify-packed-tags-input.mjs",
    "test:packed-toggle": "pnpm build && node scripts/verify-packed-toggle.mjs",
    "test:packed-action-bar": "pnpm build && node scripts/verify-packed-action-bar.mjs",
    "test:packed-collapsible": "pnpm build && node scripts/verify-packed-collapsible.mjs",
    "test:packed-drawer": "pnpm build && node scripts/verify-packed-drawer.mjs",
    "test:packed-floating-panel": "pnpm build && node scripts/verify-packed-floating-panel.mjs",
    "test": "vitest run && pnpm test:server && pnpm test:tooling",
    "test:tooling": "node --test \"tests/tooling/*.test.mjs\" && pnpm check:theme-reference",
    "build:runtime": "node scripts/generate-public-entry.mjs --check && vite build --config vite.build.config.ts && vite build --config vite.server.config.ts",
    "build:artifacts": "node scripts/generate-default-css.mjs && node scripts/build-package-docs.mjs && node scripts/build-declarations.mjs && pnpm verify:package",
    "generate:theme-reference": "node scripts/generate-theme-variable-reference.mjs",
    "check:theme-reference": "node scripts/generate-theme-variable-reference.mjs --check",
    "build": "pnpm build:runtime && pnpm build:artifacts",
    "verify:package": "node scripts/generate-public-entry.mjs --check && node --test tests/tooling/package-content-policy.test.mjs && node scripts/verify-package.mjs && node scripts/verify-package-content.mjs"
  },
  "dependencies": {
    "@internationalized/date": "3.12.3",
    "@zag-js/accordion": "2.0.0-next.4",
    "@zag-js/anatomy": "2.0.0-next.4",
    "@zag-js/async-list": "2.0.0-next.4",
    "@zag-js/auto-resize": "2.0.0-next.4",
    "@zag-js/avatar": "2.0.0-next.4",
    "@zag-js/carousel": "2.0.0-next.4",
    "@zag-js/checkbox": "2.0.0-next.4",
