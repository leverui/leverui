    "@zag-js/color-utils": "2.0.0-next.4",
    "@zag-js/combobox": "2.0.0-next.4",
    "@zag-js/core": "2.0.0-next.4",
    "@zag-js/date-input": "2.0.0-next.4",
    "@zag-js/date-picker": "2.0.0-next.4",
    "@zag-js/date-utils": "2.0.0-next.4",
    "@zag-js/dialog": "2.0.0-next.4",
    "@zag-js/dom-query": "2.0.0-next.4",
    "@zag-js/editable": "2.0.0-next.4",
    "@zag-js/file-upload": "2.0.0-next.4",
    "@zag-js/file-utils": "2.0.0-next.4",
    "@zag-js/floating-panel": "2.0.0-next.4",
    "@zag-js/focus-trap": "2.0.0-next.4",
    "@zag-js/focus-visible": "2.0.0-next.4",
    "@zag-js/highlight-word": "2.0.0-next.4",
    "@zag-js/hotkeys": "2.0.0-next.4",
    "@zag-js/hover-card": "2.0.0-next.4",
    "@zag-js/i18n-utils": "2.0.0-next.4",
    "@zag-js/listbox": "2.0.0-next.4",
    "@zag-js/marquee": "2.0.0-next.4",
    "@zag-js/menu": "2.0.0-next.4",
    "@zag-js/number-input": "2.0.0-next.4",
    "@zag-js/pagination": "2.0.0-next.4",
    "@zag-js/pin-input": "2.0.0-next.4",
    "@zag-js/popover": "2.0.0-next.4",
    "@zag-js/presence": "2.0.0-next.4",
    "@zag-js/progress": "2.0.0-next.4",
    "@zag-js/qr-code": "2.0.0-next.4",
    "@zag-js/radio-group": "2.0.0-next.4",
    "@zag-js/rating-group": "2.0.0-next.4",
    "@zag-js/scroll-area": "2.0.0-next.4",
    "@zag-js/select": "2.0.0-next.4",
    "@zag-js/slider": "2.0.0-next.4",
    "@zag-js/solid": "2.0.0-next.4",
    "@zag-js/splitter": "2.0.0-next.4",
    "@zag-js/steps": "2.0.0-next.4",
    "@zag-js/switch": "2.0.0-next.4",
    "@zag-js/tabs": "2.0.0-next.4",
    "@zag-js/tags-input": "2.0.0-next.4",
    "@zag-js/toast": "2.0.0-next.4",
    "@zag-js/toggle": "2.0.0-next.4",
    "@zag-js/tooltip": "2.0.0-next.4",
    "@zag-js/tree-view": "2.0.0-next.4",
    "@zag-js/types": "2.0.0-next.4",
    "@zag-js/utils": "2.0.0-next.4",
    "parse5": "8.0.1"
  },
  "peerDependencies": {
    "@solidjs/web": ">=2.0.0 <3",
    "solid-js": ">=2.0.0 <3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/wix-madefor-text": "5.3.0",
    "@lucide/solid": "1.72.0",
    "@playwright/test": "1.64.1",
    "@solidjs/testing-library": "1.0.0-rc.2",
    "@solidjs/vite-plugin": "3.0.1",
    "@solidjs/web": "2.0.3",
    "@storybook/addon-a11y": "11.0.0-beta.3",
    "@storybook/addon-themes": "11.0.0-beta.3",
    "@tanstack/table-core": "9.3.1",
    "@tanstack/virtual-core": "3.19.11",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@types/node": "26.6.5",
    "axe-core": "4.14.0",
    "bootstrap-icons": "1.13.2",
    "check-password-strength": "^3.0.0",
    "emojibase-data": "18.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "65.3.6",
    "eslint-plugin-solid": "0.19.0",
    "globals": "17.13.0",
    "highlight.js": "11.12.0",
    "jsdom": "30.1.3",
    "micromark": "4.0.3",
    "prettier": "3.9.10",
    "shiki": "4.5.0",
    "solid-js": "2.0.3",
    "storybook": "11.0.0-beta.3",
    "storybook-solidjs-vite": "11.0.0-next-20261105190313",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
